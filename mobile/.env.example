# Configuration API Backend Onbora Mobile (.env.example)
# En développement local (PC et smartphone sur le même réseau local) :
# Remplacer par l'IP de votre machine (ex: 10.160.92.202:8000)
API_BASE_URL=http://10.160.92.202:8000

# En production sur Render :
# API_BASE_URL=https://onbora-backend.onrender.com

# Clés optionnelles
API_TOKEN=
MAPTILER_API_KEY=YOUR_MAPTILER_KEY
