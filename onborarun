#!/usr/bin/env bash

# ==============================================================================
# Script onborarun — Lancement de tous les services Onbora (Core AI Native)
# ==============================================================================

echo "=================================================="
echo "🚀 Lancement de l'écosystème complet Onbora"
echo "=================================================="

# Detection & activation du virtualenv Python (venv)
if [ -f "backend/venv/Scripts/activate" ]; then
    source backend/venv/Scripts/activate
elif [ -f ".venv/Scripts/activate" ]; then
    source .venv/Scripts/activate
elif [ -f "backend/venv/bin/activate" ]; then
    source backend/venv/bin/activate
elif [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
fi

PYTHON_CMD="python"
if command -v python3 &>/dev/null; then
    PYTHON_CMD="python3"
fi

# 1. Lancement du Core AI Service (Port 8001)
echo "1. Démarrage du Core AI Service (Port 8001)..."
(cd core-ai && $PYTHON_CMD manage.py runserver 0.0.0.0:8001) &
PID_CORE_AI=$!

# 2. Lancement du Backend Django (Port 8000)
echo "2. Démarrage du Backend Django (Port 8000)..."
(cd backend && $PYTHON_CMD manage.py runserver 0.0.0.0:8000) &
PID_BACKEND=$!

# 3. Lancement du Frontend Next.js (Port 3000)
echo "3. Démarrage du Frontend Next.js (Port 3000)..."
(cd frontend && npm run dev) &
PID_FRONTEND=$!

echo "--------------------------------------------------"
echo "✅ Tous les services Onbora s'exécutent dans cette fenêtre :"
echo "   - Frontend Next.js     : http://localhost:3000"
echo "   - Backend Django       : http://localhost:8000"
echo "   - Core AI Microservice : http://localhost:8001"
echo "--------------------------------------------------"
echo "Appuyez sur Ctrl+C pour arrêter tous les services."

trap "kill $PID_CORE_AI $PID_BACKEND $PID_FRONTEND 2>/dev/null" EXIT INT TERM
wait
